{
  "component": "eds.tooltip",
  "requiredVariables": [
    {
      "name": "recipe/optical-padding-xs-squared-sm-label",
      "collection": "density",
      "values": {
        "compact": 4,
        "comfortable": 6,
        "relaxed": 10
      },
      "codeSyntax": "calc(var(--eds-spacing-inset-xs-vertical-squared) - var(--eds-half-leading-sm))",
      "description": "eds.tooltip: sm label in the xs-squared inset. Resolved because Figma cannot calc; CSS composes it live. Heights land at 20/24/36."
    },
    {
      "name": "recipe/pointer-sm",
      "collection": "density",
      "values": {
        "compact": 4,
        "comfortable": 4,
        "relaxed": 6
      },
      "codeSyntax": "calc(var(--eds-cap-rounded-sm) / 2)",
      "description": "eds.tooltip: the bubble pointer's protrusion — half the sm cap box, so the arrow scales with density like everything else. Resolved because Figma cannot calc; CSS composes it live."
    }
  ],
  "componentSet": {
    "name": "Tooltip",
    "description": "Tooltip — the floating hint, NEGATIVE: an inverse panel (near-black on light, near-white on dark) via the bg-inverse/text-on-inverse concept tokens, as EDS 1.x had it. Height emerges from the recipe: xs inset × 2 + cap(sm label). Twelve placements (side × start/center/end) — the full EDS 1.0 arrow fan, kept because product teams use all of it. PLACEMENT names where the TOOLTIP sits relative to its ANCHOR — the arrow points back at the anchor (Placement=Top: bubble above the target, arrow on the bubble's bottom edge). Same convention as Floating UI, CSS anchor positioning and EDS 1.0 (Popper). On a bare canvas this reads inverted; snap an instance to its target and it is right.\n\nGenerated from eds.tooltip v0.3.0 — edit the contract, not this component.",
    "axes": {
      "Side": [
        "Top",
        "Bottom",
        "Left",
        "Right"
      ],
      "Align": [
        "Start",
        "Center",
        "End"
      ],
      "State": [
