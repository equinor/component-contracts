{
  "name": "component-contracts",
  "private": true,
  "description": "JSON contracts generate EDS components in both CSS and Figma; a parity harness proves the surfaces agree.",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "preinstall": "pnpm dlx only-allow pnpm",
    "build": "pnpm --filter @equinor/eds-tokens build && pnpm --filter @equinor/eds-contracts build",
    "test": "pnpm -r test",
    "a11y": "pnpm --filter @equinor/eds-tokens a11y",
    "preview": "pnpm dlx serve .",
    "pages": "node scripts/build-pages.mjs"
  }
}
